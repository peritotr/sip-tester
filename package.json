{
  "name": "sip-tester",
  "productName": "SIP Tester",
  "version": "0.1.0",
  "description": "SIP load tester for PBXes and SIP servers: calls (INVITE) with light RTP, registration storms and OPTIONS, step tests and performance reports — desktop app and Docker web server",
  "keywords": [
    "sip",
    "voip",
    "pbx",
    "asterisk",
    "freeswitch",
    "sbc",
    "load-testing",
    "performance",
    "rtp",
    "electron"
  ],
  "homepage": "https://github.com/peritotr/sip-tester#readme",
  "bugs": {
    "url": "https://github.com/peritotr/sip-tester/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peritotr/sip-tester.git"
  },
  "license": "MIT",
  "author": "Levent Karamanlı",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "i18n": "node tools/i18n-keys.js",
    "bench": "node tools/bench.js 1000 30 10",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "uas": "node uas.js 5070"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.peritotr.siptester",
    "productName": "SIP Tester",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sip-core.js",
      "sip-client.js",
      "rtp.js",
      "load-engine.js",
      "load-worker.js",
      "ipc-child.js",
      "hist.js",
      "reports.js",
      "ui/**",
      "package.json"
    ],
    "artifactName": "SIP-Tester-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SIP-Tester-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SIP-Tester-${version}-win-${arch}-portable.${ext}"
    }
  }
}
